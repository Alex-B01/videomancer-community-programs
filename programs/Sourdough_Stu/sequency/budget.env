# budget.env — SEQUENCY (full-chroma WHT organ, 3× wht_organ_lane) resource/timing gate ceilings.
# Created at Gate 3 (synth audit); updated 2026-07-19 at Gate 0 REV-D finalization (full-chroma committed).
# COMMITTED (levered) ~6,600 LC / 17 EBR / lat 44. WARN_LC/MAX_LC are the tiered gates.
WARN_LC=5500    # comfortable-target line; committed build sits above this (WARN band, by design)
MAX_LC=7200     # hard gate (~94% of the 7,680 die); NOT raised — full-chroma engineered UNDER via §3.2 levers.
                # Gate-1 feature-complete smoke STOPS if measured LC > 7200 (escalate: aggressive levers / sign-off / Y-only).
MAX_EBR=20      # raised 14->20 for committed packed full-chroma (17 EBR: REGEN Y 6 + REGEN U+V packed 8 + delay 3).
                # Device ceiling 32; shipping programs sit at 29-30, so 17<=20 is comfortable (3 EBR headroom), 20<=22.
MIN_FMAX=76     # HD Fmax gate (MHz); overrides --min-fmax in verify_program.sh. Gate-1 smoke STOPS if any HD Fmax < 76.
