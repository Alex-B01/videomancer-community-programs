# budget.env — SEQUENCY (Y-only WHT organ, single wht_organ_lane, R2SDF streaming) resource/timing gate ceilings.
# Created at Gate 3 (synth audit); rewritten 2026-07-19 at Gate 4 packaging (Y-only committed; full-chroma retired).
# COMMITTED (Y-only, U/V passthrough) — measured LC 3,782 (hd_hdmi / seed 1; worst-sweep 3,810) / EBR 9 / latency 52 /
#   worst HD Fmax 81.49 MHz (full 6-config x 3-seed sweep). All four gates hold with comfortable headroom.
WARN_LC=5500    # comfortable-target line; Y-only build (3,782 / worst 3,810) sits well BELOW this — no WARN band.
MAX_LC=7200     # hard gate (~94% of the 7,680-LC die); NOT raised. Gate-1 smoke STOPS if measured LC > 7200.
MAX_EBR=14      # lowered 20->14 (the Program-5 design-doc ceiling); Y-only uses 9 EBR (REGEN Y 6 + delay 3), 5 headroom.
                # Device ceiling 32. 9 <= 14 already holds at Gate 3 — no re-synth; kept tight now full-chroma is gone.
MIN_FMAX=76     # HD Fmax gate (MHz); overrides --min-fmax in verify_program.sh. Gate-1 smoke STOPS if any HD Fmax < 76.
