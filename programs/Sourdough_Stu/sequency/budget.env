# budget.env — SEQUENCY (Y-only WHT organ) resource/timing gate ceilings.
# Created at Gate 3 (synth audit); updated 2026-07-18 to the tiered LC ladder.
# TARGET (design aim) ~4,665 LC / 6 EBR. WARN_LC/MAX_LC are the tiered gates.
WARN_LC=5500    # comfortable-target line; above this the build passes with a WARN
MAX_LC=7200     # hard gate (~94% of the 7,680 die); above this = auto-fail (sign-off to override)
MAX_EBR=14      # EBR gate ceiling (ledger target 6; physical = 32)
MIN_FMAX=76     # HD Fmax gate (MHz); overrides --min-fmax in verify_program.sh
