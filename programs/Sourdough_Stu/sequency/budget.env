# budget.env — SEQUENCY (Y-only WHT organ, single wht_organ_lane, R2SDF streaming) resource/timing gate ceilings.
# Created at Gate 3 (synth audit); rewritten 2026-07-19 at Gate 4 packaging (Y-only committed; full-chroma retired);
#   re-updated 2026-07-19 for REV-F re-package — the four formerly-dead controls are now LIVE (Crosstalk/Chroma/
#   Dithered/Rotate; latency 52->56, +~470 LC, ZERO added memory), and Gate 3 REV-F re-ran the full sweep clean.
# COMMITTED REV-F (Y-only, U/V passthrough; all 12 controls functional) — measured LC 4,250 (hd_hdmi / seed 1;
#   worst-sweep 4,256) / EBR 9 / latency 56 / worst HD Fmax 83.20 MHz (+7.20 over gate; full 6-config x 3-seed
#   sweep, LC 4,243–4,256). All four gates below hold with comfortable headroom — VALUES unchanged since Gate 3.
WARN_LC=5500    # comfortable-target line; REV-F build (4,250 / worst 4,256) sits well BELOW this — no WARN band (1,244 clear).
MAX_LC=7200     # hard gate (~94% of the 7,680-LC die); NOT raised. Gate-1 smoke STOPS if measured LC > 7200.
MAX_EBR=14      # lowered 20->14 (the Program-5 design-doc ceiling); REV-F uses 9 EBR (REGEN Y 6 + sync/dry-Y/U-V delay 3), 5 headroom.
                # Device ceiling 32. REV-F re-synth confirms 9 (leak/dither/rotate are FF+comb, add ZERO memory). 9 <= 14 holds.
MIN_FMAX=76     # HD Fmax gate (MHz); overrides --min-fmax in verify_program.sh. Gate-1 smoke STOPS if any HD Fmax < 76.
