# budget.env -- WITNESS (Program 8) resource/timing gate ceilings (Gate-0 PAPER, REV-B).
# Serial per-pixel compositor + vblank serial moments/ellipse. Div-1 full-clock (no hd_clock_divisor).
# Structural class = sync_bleed/kintsugi/howler (CALIBRATED) -> paper LC is an estimate, NOT the
# SEQUENCY parallel-transform lower-bound trap. BUT 4 blocks are UNMEASURED (full-res wide moment
# accumulators, bresenham_indexer, vblank ellipse eigen-solver, motion-history/stamp BRAM inference).
# REV-B added the OQ-2 hue-weighted track (0 EBR, 0 multiply, ~+170 LC) -> point estimate ~5,350,
# only ~150 under WARN_LC -> a Gate-1 WARN is materially likely (still << 7200 hard gate). SMOKE AUTHORITATIVE.
WARN_LC=5500     # comfortable target; Gate-0 paper point-estimate ~5,350 (band 5,050-5,850).
MAX_LC=7200      # hard gate (~94% of the 7,680-LC die). Gate-1 smoke STOPS if measured LC > 7200.
MAX_EBR=14       # doc ceiling for WITNESS (9-14); Gate-0 map = 11 (motion-hist 4 + PULL 2 + sync/dry 3 + stamp 2).
MIN_FMAX=76      # HD Fmax gate (MHz); overrides --min-fmax. Gate-1 smoke STOPS if any HD Fmax < 76.
