# HOWLBOX resource budget (read by scripts/verify_program.sh)
# Paper LC ~4,920 (spec §4); serial howler-class pipeline, H3 does not apply.
# The ONLY memory is the 256x30 H-phase remap delay line = 2 EBR.
WARN_LC=5500     # comfortable target (aim here)
MAX_LC=7200      # hard gate (~94% of die)
MAX_EBR=2        # exactly the remap delay line; anything else is a defect
MIN_FMAX=76      # HD Fmax gate (3-seed sweep is the real timing net at Gate 3)
